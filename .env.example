# StoreSwift Multi-Tenant eCommerce Platform Configuration

# Database Connection (Neon, Supabase, or Local PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/storeswift?sslmode=disable"

# Application Domains
NEXT_PUBLIC_ROOT_DOMAIN="storeswift.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Security
AUTH_SECRET="super-secret-jwt-signing-key-change-in-production-min-32-chars"
AUTH_EXPIRY="7d"

# Payment Gateways (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloud Storage (Cloudflare R2 / AWS S3) for Product Images
STORAGE_BUCKET_NAME="storeswift-assets"
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="your_access_key"
STORAGE_SECRET_ACCESS_KEY="your_secret_key"
STORAGE_PUBLIC_URL="https://assets.yourplatform.com"

